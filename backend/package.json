{
  "name": "mihomo-manager-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute mihomo-sub-manager-db --local --file=schema.sql",
    "db:seed": "wrangler d1 execute mihomo-sub-manager-db --local --file=seed.sql",
    "db:remote:migrate": "wrangler d1 execute mihomo-sub-manager-db --remote --file=schema.sql",
    "db:remote:seed": "wrangler d1 execute mihomo-sub-manager-db --remote --file=seed.sql"
  },
  "dependencies": {
    "jose": "^6.0.11",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
